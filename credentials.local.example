# Modelo de credentials.local. Copie este arquivo para `credentials.local`
# (mesma pasta) e preencha os valores reais. `credentials.local` está no
# .gitignore e nunca deve ser commitado.

# Copernicus Climate Data Store — usado por src/downloaders/cds_tasmax_downloader.py
# Chave em https://cds.climate.copernicus.eu/ (perfil do usuario, "API key").
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=your-cds-api-key-here

# Google Earth Engine — usado por src/downloaders/aqueduct_downloader.py.
# ID do projeto Cloud habilitado para o Earth Engine. Alem desta variavel, o
# GEE exige um token local gerado por `earthengine authenticate` (fora deste
# arquivo). Sem GEE_PROJECT_ID a etapa do Aqueduct e apenas pulada.
GEE_PROJECT_ID=your-gcp-project-id-here
